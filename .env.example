# Supabase
# Boleh pakai nama baru: SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Opsional, untuk atribusi OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=school-quiz

# CORS: pisahkan dengan koma, tanpa wildcard
FRONTEND_ORIGINS=http://localhost:5173

# Kuota (placeholder, sesuaikan dengan free tier)
AI_USER_HOURLY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=200

# Server
PORT=3000
